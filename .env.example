OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# NAVER API HUB Application credentials are used with X-NCP-APIGW headers.
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
META_PUBLIC_CONTENT_ACCESS=unknown
# OpenAI 비용 보호(서버 메모리 기준): 클라이언트별 분당 호출 수, 프로세스 일일 상한
OPENAI_RATE_PER_MINUTE=6
OPENAI_DAILY_LIMIT=60
