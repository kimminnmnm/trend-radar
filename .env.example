OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# NAVER API HUB Application credentials are used with X-NCP-APIGW headers.
YOUTUBE_API_KEY=
# 캐시 미스 기준 YouTube search.list의 프로세스 일일 상한
YOUTUBE_DAILY_SEARCH_LIMIT=20
# Google Trends API는 Alpha 승인 전에는 연결하지 않습니다. 비공식 스크래핑도 사용하지 않습니다.
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
META_PUBLIC_CONTENT_ACCESS=unknown
# OpenAI 비용 보호(서버 메모리 기준): 클라이언트별 분당 호출 수, 프로세스 일일 상한
OPENAI_RATE_PER_MINUTE=6
OPENAI_DAILY_LIMIT=60
# 비용이 드는 API(OpenAI·NAVER·Meta) 접근 제어: open | auth | allowlist
#   비워 두면 개발(npm run dev)=open, 배포(npm run start)=auth
#   공개 배포 시에는 allowlist 권장(Supabase는 누구나 가입할 수 있으므로 auth만으로는 남용을 막지 못함)
PAID_API_ACCESS=
# allowlist 모드에서 실제 분석을 허용할 이메일(쉼표 구분)
PAID_API_ALLOWED_EMAILS=
# OpenAI 호출 전에 NAVER·Meta를 부르는 요청의 클라이언트별 분당 상한
EXTERNAL_RATE_PER_MINUTE=10
